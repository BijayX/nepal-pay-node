{
  "name": "@bijayx/nepal-pay",
  "version": "0.1.0",
  "description": "Type-safe Khalti and eSewa payment gateway SDK for Node.js — one API, server-side verification, typed errors.",
  "keywords": [
    "khalti",
    "esewa",
    "nepal",
    "payment",
    "payment-gateway",
    "npr",
    "typescript"
  ],
  "license": "MIT",
  "author": "Bijay Shrestha",
  "homepage": "https://github.com/BijayX/nepal-pay-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BijayX/nepal-pay-node.git"
  },
  "bugs": {
    "url": "https://github.com/BijayX/nepal-pay-node/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  }
}
